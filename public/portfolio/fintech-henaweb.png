<svg width="400" height="300" viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="400" height="300" fill="#1a1a1a"/>
  <rect x="20" y="20" width="360" height="260" rx="12" fill="#2a2a2a" stroke="#3a3a3a" stroke-width="2"/>
  
  <!-- Header -->
  <rect x="40" y="40" width="80" height="20" rx="4" fill="#4a4a4a"/>
  <rect x="140" y="40" width="60" height="20" rx="4" fill="#4a4a4a"/>
  <rect x="220" y="40" width="100" height="20" rx="4" fill="#4a4a4a"/>
  
  <!-- Main content area -->
  <rect x="40" y="80" width="320" height="40" rx="6" fill="#3a3a3a"/>
  <rect x="40" y="140" width="200" height="30" rx="4" fill="#4a4a4a"/>
  <rect x="260" y="140" width="100" height="30" rx="4" fill="#4a4a4a"/>
  
  <!-- Cards -->
  <rect x="40" y="190" width="150" height="60" rx="8" fill="#2d4a3a" stroke="#4a6a5a" stroke-width="1"/>
  <rect x="210" y="190" width="150" height="60" rx="8" fill="#3a2d4a" stroke="#5a4a6a" stroke-width="1"/>
  
  <!-- Icons -->
  <circle cx="70" cy="220" r="8" fill="#6a8a7a"/>
  <circle cx="240" cy="220" r="8" fill="#8a6a7a"/>
  
  <!-- Text placeholder -->
  <rect x="50" y="200" width="80" height="8" rx="2" fill="#8a9a8a"/>
  <rect x="220" y="200" width="80" height="8" rx="2" fill="#9a8a8a"/>
  
  <!-- Fintech branding -->
  <text x="200" y="280" text-anchor="middle" fill="#6a8a7a" font-family="Arial, sans-serif" font-size="14" font-weight="bold">FINTECH HENAWEB</text>
</svg>